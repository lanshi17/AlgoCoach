# Claude API
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override model (defaults to claude-opus-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5
# Optional: Anthropic-compatible proxy endpoint
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Remotion render binary (use `npx` for auto-install or full path)
REMOTION_BIN=npx

# Data directories (auto-created if absent)
DB_PATH=./data/agent.db
OUTPUT_DIR=./data/animations
# Local ChromaDB vector memory (problem statements / explanations / sticking
# points). Persisted on this machine only; never uploaded. The local embedding
# model is loaded lazily on the first index/query.
CHROMA_PATH=./data/chroma
# Embedded ReMe conversation memory (AgentScope middleware). Local files only;
# the app never starts a standalone ReMe service.
REME_WORKSPACE_DIR=./data/reme
# Stable AgentScope session id for POST /chat (the request has no session field).
# ALGOCOACH_SESSION_ID=default

# Cron scheduler (P1)
# Timezone used only for trigger times and notification date labels.
ALGOCOACH_TIMEZONE=Asia/Shanghai
# Set to false for tests/local runs where scheduled jobs should not start.
ALGOCOACH_CRONS_ENABLED=true
# Java gateway used by the daily problem job and the fetch_problem_meta tool.
GATEWAY_BASE_URL=http://localhost:8080
GATEWAY_TIMEOUT_SECONDS=10

# P2 generated Remotion code sandbox (default off).
# Only an explicit "true" enables POST /animate/generated; the path then still
# requires a real Bubblewrap preflight (bwrap + unprivileged user namespaces,
# Node, Chrome, and a systemd user manager with cgroup v2 memory/pids/cpu
# delegation). If anything is missing the request fails closed with
# SandboxUnavailable and no generated code runs on the host.
REMOTION_CODEGEN_ENABLED=false
# Bearer token required by POST /animate/generated when enabled. If this is
# blank while the feature is enabled, the endpoint fails closed (503) before
# reading the body; the token is never logged or echoed.
REMOTION_CODEGEN_TOKEN=
# Max queued + rendering generated jobs (clamped to 1-2). Prebuilt animation
# jobs are not affected; a full generated queue returns 429.
REMOTION_CODEGEN_MAX_ACTIVE_JOBS=1
# Optional overrides (usually auto-detected):
# REMOTION_CODEGEN_TMP_ROOT=./data/tmp/remotion-codegen
# REMOTION_CODEGEN_TIMEOUT_SECONDS=90
# REMOTION_CODEGEN_BWRAP_BIN=/usr/bin/bwrap
# REMOTION_CODEGEN_NODE_BIN=/path/to/node
# REMOTION_CODEGEN_CHROME_BIN=/usr/bin/google-chrome
