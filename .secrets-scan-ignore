# False positives confirmed on 2026-11-16 before pushing the multi-platform branch.
# Each entry is a variable name, an env-var lookup, test fixture text, or a doc command —
# no literal credential. Re-verify this list whenever one of these files changes.

# Agent: provider credentials are read from env/request, never embedded.
backend/agent/app/agent/coach\.py:.*_token = 
backend/agent/app/agent/coach\.py:.*(os\.getenv\("ANTHROPIC_API_KEY"|api_key = str\(cfg|SecretStr\(api_key|Credential\(api_key=|_token\.set\()
backend/agent/app/agent/crons\.py:.*(ANTHROPIC_API_KEY|AsyncAnthropic\(api_key=api_key\))
backend/agent/app/agent/router\.py:.*remotion_codegen_token

# Gateway test fixtures that deliberately simulate leaked upstream bodies.
backend/gateway/src/test/java/com/algocoach/exception/GlobalExceptionHandlerTest\.java:.*(upstream-secret-body|leaked-cookie-value)

# Docs: Maven command inside a docker run example.
docs/backend-gateway\.md:.*docker run

# Generated-code lexer: `token` is a parsed identifier/Bearer slice, no credential.
backend/agent/app/remotion/codegen\.py:.*token = (tokens\[index\]|value\.strip\(\))

# Frontend: field names and sessionStorage keys, no values.
frontend/src/components/Layout/AppShell\.tsx:.*checkAuth
frontend/src/pages/SettingsPage\.tsx:.*aria-label="Provider API key"
frontend/src/pages/SettingsPage\.test\.tsx:.*aria-label="Provider API key"
frontend/src/stores/useAppStore\.ts:.*sessionStorage\.getItem\('algocoach\.provider\.apiKey'\)
frontend/src/stores/useAppStore\.ts:.*const apiKey = readProviderApiKey\(

# Knowledge-base Provider credentials are user-entered runtime configuration;
# the code stores them only under the local KNOWLEDGE_DIR and never embeds one.
backend/agent/app/memory/knowledge_base\.py:.*(hasApiKey|api_key|apiKey)
frontend/src/pages/KnowledgeBasePage\.tsx:.*apiKey
backend/agent/tests/test_knowledge_base\.py:.*secret-value

# Template and test fixtures: a literal placeholder, never a real credential.
^\.env\.example:.*ANTHROPIC_API_KEY=sk-ant-\.\.\.$
backend/agent/tests/conftest\.py:.*AnthropicCredential\(api_key="test-key-not-used"\)
backend/agent/tests/test_contest_training\.py:.*"apiKey": "(request-only-secret|test-key-not-used)"

# The ignore file's own regex lines look like assignments to the scanner.
^\.secrets-scan-ignore:
